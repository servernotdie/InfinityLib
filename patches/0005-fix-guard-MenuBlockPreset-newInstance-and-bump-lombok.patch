From b16e267ae7fe36d1a480b1d4a8938d4dd339c590 Mon Sep 17 00:00:00 2001
From: mytai20100 <142713298+Mytai20100@users.noreply.github.com>
Date: Wed, 5 Aug 2026 22:08:42 +0700
Subject: [PATCH] fix: guard MenuBlockPreset newInstance and bump lombok to
 1.18.32

---
 pom.xml                                                   | 2 +-
 .../mooy1/infinitylib/machines/MenuBlockPreset.java       | 8 ++++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/pom.xml b/pom.xml
index 9cc8342..0313430 100644
--- a/pom.xml
+++ b/pom.xml
@@ -61,7 +61,7 @@
         <dependency>
             <groupId>org.projectlombok</groupId>
             <artifactId>lombok</artifactId>
-            <version>1.18.20</version>
+            <version>1.18.32</version>
             <scope>provided</scope>
         </dependency>
 
diff --git a/src/main/java/io/github/mooy1/infinitylib/machines/MenuBlockPreset.java b/src/main/java/io/github/mooy1/infinitylib/machines/MenuBlockPreset.java
index 4f51b7d..c6536c9 100644
--- a/src/main/java/io/github/mooy1/infinitylib/machines/MenuBlockPreset.java
+++ b/src/main/java/io/github/mooy1/infinitylib/machines/MenuBlockPreset.java
@@ -8,6 +8,8 @@ import org.bukkit.inventory.ItemStack;
 
 import io.github.thebusybiscuit.slimefun4.implementation.Slimefun;
 import io.github.thebusybiscuit.slimefun4.libraries.dough.protection.Interaction;
+import com.xzavier0722.mc.plugin.slimefun4.storage.controller.SlimefunBlockData;
+import com.xzavier0722.mc.plugin.slimefun4.storage.util.StorageCacheUtils;
 import me.mrCookieSlime.Slimefun.api.inventory.BlockMenu;
 import me.mrCookieSlime.Slimefun.api.inventory.BlockMenuPreset;
 import me.mrCookieSlime.Slimefun.api.inventory.DirtyChestMenu;
@@ -26,6 +28,12 @@ final class MenuBlockPreset extends BlockMenuPreset {
 
     @Override
     public void newInstance(BlockMenu menu, Block b) {
+        SlimefunBlockData blockData = StorageCacheUtils.getBlock(b.getLocation());
+
+        if (blockData == null || !blockData.isDataLoaded()) {
+            return;
+        }
+
         menuBlock.onNewInstance(menu, b);
     }
 
-- 
